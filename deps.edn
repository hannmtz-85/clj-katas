{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}}
 :aliases
 {;; clojure -M:test                         all tests
  ;; clojure -M:test --focus katas.arrays-test/two-sum-sorted   one test
  :test {:extra-paths ["test"]
         :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
         :main-opts ["-m" "kaocha.runner"]}

  ;; clojure -M:nrepl   starts an nREPL server on port 7888 that an editor can connect to
  ;; (in Calva: "Connect to a Running REPL Server", deps.edn, localhost:7888), with the
  ;; tests and Kaocha on the classpath: (require '[kaocha.repl :as k]) (k/run 'katas.arrays-test)
  :nrepl {:extra-paths ["test"]
          :extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                       nrepl/nrepl {:mvn/version "1.5.1"}
                       cider/cider-nrepl {:mvn/version "0.58.0"}}
          :main-opts ["-m" "nrepl.cmdline"
                      "--middleware" "[cider.nrepl/cider-middleware]"
                      "--port" "7888"]}}}
